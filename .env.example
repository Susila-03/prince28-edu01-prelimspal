# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=prelimspal
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json
# Paste your Neon connection string here, in .env only (it contains your password).
# It starts with postgresql:// and ends with ?sslmode=require (Neon dashboard > Connect).
DATABASE_URL=postgresql://localhost:5432/prelimspal
# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env and Render only. Never commit real API keys.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
